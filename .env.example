HARM_ADMIN_USERNAME=choose-a-username
HARM_ADMIN_PASSWORD=replace-with-a-long-unique-password
HARM_SESSION_SECRET=generate-at-least-32-random-characters
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: verified Google Business Ask for reviews link; otherwise QR opens Maps search.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Public website origin for the customer-review QR. Local preview otherwise uses the LAN address.
NEXT_PUBLIC_SITE_URL=
